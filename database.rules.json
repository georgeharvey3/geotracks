{
  "rules": {
    ".read": false,
    ".write": false,
    "scores": {
      ".read": true,
      ".indexOn": ["score"],
      "$scoreId": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'score', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1500"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "communityAlbums": {
      ".read": true
    },
    "suggestions": {
      ".read": "auth != null && auth.uid === 'ylygYsvdKIhWoqQvZIvVRMjifsR2'",
      "$suggestionId": {
        ".write": "(auth != null && !data.exists() && newData.exists()) || (auth != null && auth.uid === 'ylygYsvdKIhWoqQvZIvVRMjifsR2')",
        ".validate": "newData.hasChildren(['albumId', 'countryCode', 'uid', 'createdAt'])",
        "albumId": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{22}$/)"
        },
        "countryCode": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "uid": {
          ".validate": "newData.val() == auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
