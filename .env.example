# These VITE_FIREBASE_* vars are OPTIONAL: the same public web-config values are
# committed as fallbacks in `src/config.ts`, so the app and leaderboard work
# without a `.env`. Only set these to point a fork at a *different* Firebase
# project — an override here wins over the committed default.
#
# These are Firebase *web* config values — public client identifiers by design,
# not secrets. The leaderboard is protected by the RTDB security rules
# (`database.rules.json`) plus anonymous auth, not by hiding these values. Find
# them in the Firebase console: Project settings → General → Your apps → SDK
# setup and configuration. Only variables prefixed with VITE_ reach the bundle.

# Base URL of the Firebase Realtime Database backing the leaderboard. Scores
# live at `${VITE_FIREBASE_DB_URL}/scores`.
VITE_FIREBASE_DB_URL=https://geotracks-d9b5c-default-rtdb.europe-west1.firebasedatabase.app

# Firebase web app config. Submitting a score also needs the Anonymous sign-in
# provider enabled in the console (Authentication → Sign-in method).
VITE_FIREBASE_API_KEY=AIzaSyC6o9I68tn0KiDNaceuQF1UjKpo4YJRoV8
VITE_FIREBASE_AUTH_DOMAIN=geotracks-d9b5c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=geotracks-d9b5c
VITE_FIREBASE_STORAGE_BUCKET=geotracks-d9b5c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=309832762507
VITE_FIREBASE_APP_ID=1:309832762507:web:00232dc3ff78ae898ac08e

# ---------------------------------------------------------------------------
# THESE TWO ARE REAL SECRETS. Everything above is a public client identifier;
# these are not, and they are the first genuine secrets this repo has ever had.
#
# They MUST NOT be given a VITE_ prefix. Vite injects every VITE_* variable into
# the client bundle, so a rename to VITE_SPOTIFY_CLIENT_SECRET would publish
# this credential to every visitor of the site, permanently, in a file served
# from GitHub Pages. Nothing in `src/` reads these and nothing ever should.
#
# They are used by `node scripts/add-community-album.ts`, which runs on a
# maintainer's machine to accept a Suggestion (issue #40, ADR-0005). It uses the
# client-credentials flow to read public catalogue data — no user login, free.
# Create an app at https://developer.spotify.com/dashboard to get a pair.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
